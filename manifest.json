{
  "manifest_version": 3,
  "name": "Hush: Much more calm X",
  "short_name": "Hush",
  "version": "1.0.0",
  "description": "Mutes the dopamine on X: like and view counts, notification badges, For You, trends and suggestions.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"],
      "js": ["src/settings.js", "src/content.js"],
      "css": ["src/hush.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Hush",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
